if(NOT DEFINED CLI OR NOT DEFINED WORKER OR NOT DEFINED TARGET OR NOT DEFINED OUT OR NOT DEFINED FAULT OR NOT DEFINED EXPECTED)
  message(FATAL_ERROR "missing test arguments")
endif()
file(REMOVE_RECURSE "${OUT}")
execute_process(COMMAND "${CLI}" test --target "${TARGET}" --worker "${WORKER}" --out "${OUT}"
  --profile level1 --fixture-fault "${FAULT}" --timeout-ms 250 --seed 123
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(rc EQUAL 0)
  message(FATAL_ERROR "fault '${FAULT}' unexpectedly passed")
endif()
file(GLOB cases "${OUT}/cases/*.json")
if(NOT cases)
  message(FATAL_ERROR "no case evidence was persisted; stdout=${stdout}; stderr=${stderr}")
endif()
set(found FALSE)
foreach(case IN LISTS cases)
  file(READ "${case}" data)
  if(data MATCHES "\"classification\": \"${EXPECTED}\"")
    set(found TRUE)
  endif()
  if(NOT data MATCHES "\"status\": \"FAIL\"")
    message(FATAL_ERROR "failure evidence did not retain FAIL status: ${case}")
  endif()
endforeach()
if(NOT found)
  message(FATAL_ERROR "expected classification '${EXPECTED}' not found in persisted evidence")
endif()
